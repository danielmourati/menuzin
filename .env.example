# Variáveis de ambiente usadas pelo Menuzin (valores reais ficam no cofre de secrets)

# --- Mercado Pago (plataforma) ---
# Client ID (Application ID) numérico da aplicação Mercado Pago
MP_CLIENT_ID=1234567890123456
MP_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Opcional: sobrescreve a URL de retorno do OAuth (padrão: https://menuzin.app/api/public/mp-oauth-callback)
MP_OAUTH_REDIRECT_URI=https://menuzin.app/api/public/mp-oauth-callback
# Access token da conta Mercado Pago da própria plataforma (PIX de assinaturas/destaques)
MENUZIN_MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx

# --- Criptografia de credenciais dos lojistas (AES-GCM) ---
# NÃO rotacionar sem plano de migração: tokens já gravados ficam ilegíveis.
PAYMENT_ENCRYPTION_KEY=uma_chave_longa_e_aleatoria

# --- QZ Tray (impressão) ---
QZ_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
QZ_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# --- Supabase (injetadas automaticamente pelo Lovable Cloud) ---
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=server_only_nunca_no_cliente
